# ===========================================================================
# ThoughtTracker ML — Environment Variables
# Copy to .env. Every variable is optional; defaults work out of the box.
# ===========================================================================

# Where the trained model + tokenizer are saved.
MODEL_DIR=models/stance-classifier

# Logical version string returned in /predict and /health responses.
MODEL_VERSION=stance-classifier-v1

# Topic component models used by the main app's final topic-selection policy.
TOPIC_RELEVANCE_MODEL_DIR=models/topic-relevance-classifier-supervalidation-hardneg2x-l512
TOPIC_RELEVANCE_MODEL_VERSION=topic-relevance-supervalidation-hardneg2x-l512
TOPIC_RELEVANCE_MAX_LENGTH=512
TOPIC_RERANKER_MODEL_DIR=models/topic-reranker-tfidf-sgd-supervalidation
TOPIC_RERANKER_MODEL_VERSION=topic-reranker-tfidf-sgd-v1

# Pretrained checkpoint to fine-tune.
BASE_MODEL=distilbert-base-uncased

# Training hyperparameters (kept light for laptops).
MAX_LENGTH=256
TRAIN_BATCH_SIZE=8
EVAL_BATCH_SIZE=16
NUM_TRAIN_EPOCHS=3
LEARNING_RATE=5e-5
WEIGHT_DECAY=0.01
SEED=42

# Weight the loss by inverse class frequency during training. Helps the
# minority labels (e.g. `mixed`) on the imbalanced transcript corpus.
# Truthy values: 1/true/yes. Read by src/training/train.py.
USE_CLASS_WEIGHTS=false

# Dataset. Set this when retraining the stance classifier.
DATASET_PATH=data/processed/stance_training.csv
TEST_SIZE=0.2
VAL_SIZE=0.1

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000

# Logging verbosity for the service + scripts (DEBUG/INFO/WARNING/ERROR).
# Read by src/utils/logging.py; case-insensitive.
LOG_LEVEL=INFO
